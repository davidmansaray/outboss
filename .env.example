APP_NAME=OutBoss
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://outboss.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=outboss
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/oauth/gmail/callback"

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI="${APP_URL}/oauth/microsoft/callback"

ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REDIRECT_URI="${APP_URL}/oauth/zoho/callback"

# Global campaign-send emergency kill switch. Keep false during provisioning
# and smoke checks; enable only when authorized operators are ready to send.
CAMPAIGN_SENDING_ENABLED=false

# iOS app. Push notifications turn on when the APNs values are present and the
# key is valid; check with `php artisan outboss:push:check`.
OUTBOSS_MOBILE_REDIRECT_URIS=outboss://auth/callback
# Release label the app sees from GET /api/v1/server ("dev" when empty).
OUTBOSS_VERSION=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=
APNS_PRIVATE_KEY_PATH=
OUTBOSS_INTELLIGENCE_PAUSE_NEW_RESEARCH=false
OUTBOSS_TEST_FAKE_INTELLIGENCE_PROVIDERS=false
OUTBOSS_INTELLIGENCE_RETENTION_BATCH_SIZE=100

# Bounded S2 operational status report. Values are counts/ages unless noted;
# keep labels low-cardinality so reports never contain source or subject data.
OUTBOSS_S2_OPERATIONS_MAX_ROWS=5000
OUTBOSS_S2_STUCK_AGE_SECONDS=900
OUTBOSS_S2_HELD_BUDGET_AGE_SECONDS=900
OUTBOSS_S2_PAID_RESULT_LOSS_THRESHOLD=1
OUTBOSS_S2_OUTPUT_INVALID_RATE_THRESHOLD=0.10
OUTBOSS_S2_MANUAL_REVIEW_THRESHOLD=1
OUTBOSS_S2_COST_NEAR_HARD_MAX_THRESHOLD=1
OUTBOSS_S2_COST_NEAR_HARD_MAX_RATIO=0.90
OUTBOSS_S2_RETENTION_BACKLOG_THRESHOLD=1
OUTBOSS_S2_OFFER_DEPENDENCY_THRESHOLD=1
OUTBOSS_S2_FULFILMENT_SLA_THRESHOLD=1
OUTBOSS_S2_CAPACITY_EXHAUSTION_THRESHOLD=1
OUTBOSS_S2_SIGNATURE_FAILURE_THRESHOLD=1
OUTBOSS_S2_CONVERSION_AMBIGUITY_THRESHOLD=1
OUTBOSS_S2_FENCE_REJECTION_THRESHOLD=1
OUTBOSS_SEND_RATE_PER_MINUTE=10
OUTBOSS_DEFAULT_DAILY_CAP=50
OUTBOSS_SEND_SPACING_MIN_SECONDS=45
OUTBOSS_SEND_SPACING_MAX_SECONDS=180
OUTBOSS_DOMAIN_HOURLY_LIMIT=6
OUTBOSS_HEALTH_WINDOW_HOURS=24
OUTBOSS_HARD_BOUNCE_THRESHOLD=3
OUTBOSS_PROVIDER_ERROR_THRESHOLD=5
OUTBOSS_TRACKING_HASH_SALT=

# Managed mail, experiments, and AI/research are available to authorized
# workspace owners. Authentication, workspace ownership, provider readiness,
# and product safety policies determine access; no rollout allowlist is needed.
# Fraction of eligible provider-reaching first attempts allowed to become
# unknown/manual-review before the managed experiment is paused.
OUTBOSS_EXPERIMENT_UNKNOWN_MANUAL_REVIEW_RATE_THRESHOLD=0.10

# Stalwart management settings are configuration-only. The origin is reachable
# by the Outboss server, and the admin key is a server-side secret. Never
# accept either from a request or store the admin key in the application DB.
STALWART_DEFAULT_INSTANCE=internal
# HTTPS origin of the pinned Stalwart service; leave blank until configured.
STALWART_INTERNAL_BASE_URL=
# Optional same-origin override for the URL advertised by authenticated
# /.well-known/jmap discovery. Leave blank to use discovery; do not assume /api.
STALWART_INTERNAL_MANAGEMENT_API_URL=
STALWART_INTERNAL_ADMIN_API_KEY=
STALWART_INTERNAL_VERIFY_TLS=true
STALWART_INTERNAL_TIMEOUT_SECONDS=15
STALWART_SESSION_CACHE_SECONDS=60
STALWART_INTERNAL_OUTBOUND_IPV4=
STALWART_INTERNAL_TLS_PORT=443
STALWART_DNS_RESOLVER_URL=https://cloudflare-dns.com/dns-query
STALWART_DNS_TIMEOUT_SECONDS=3
STALWART_PROVISIONING_LOCK_WAIT_SECONDS=30
STALWART_PROVISIONING_LOCK_LEASE_SECONDS=300
STALWART_RECONCILIATION_CONSISTENCY_DELAY_SECONDS=60
STALWART_RECONCILIATION_RETRY_SECONDS=30

OUTBOSS_AI_QUEUE=ai
OUTBOSS_AI_RECONCILE_AFTER_MINUTES=5
OUTBOSS_AI_FINALIZE_UNKNOWN_AFTER_HOURS=24
OUTBOSS_INTEGRATION_MONTHLY_LIMIT_MICROS=50000000
OUTBOSS_INTEGRATION_RECONCILE_AFTER_MINUTES=5
OUTBOSS_INTEGRATION_FINALIZE_AMBIGUOUS_AFTER_HOURS=24
OUTBOSS_TAVILY_DEFAULT_MICRODOLLARS_PER_CREDIT=8000

OUTBOSS_GTM_QUEUE=ai
OUTBOSS_GTM_DISPATCH_LEASE_SECONDS=300
OUTBOSS_GTM_DISPATCH_RETRY_SECONDS=30
OUTBOSS_GTM_DISPATCH_BATCH_SIZE=100
OUTBOSS_GTM_RESEARCH_TIMEOUT_SECONDS=900
OUTBOSS_GTM_RESEARCH_BACKOFF_SECONDS=30
OUTBOSS_GTM_RESEARCH_MAX_ATTEMPTS=3
OUTBOSS_GTM_RESEARCH_ATTEMPT_LEASE_SECONDS=300
OUTBOSS_GTM_RESEARCH_REFRESH_COOLDOWN_SECONDS=3600
OUTBOSS_GTM_RESEARCH_MAX_CONCURRENT_PER_WORKSPACE=1
OUTBOSS_GTM_DNS_CACHE_SECONDS=30
OUTBOSS_GTM_MAX_DNS_CACHE_ENTRIES=256
OUTBOSS_GTM_MAX_DNS_HOSTS_PER_BATCH=25
OUTBOSS_GTM_MAX_DNS_ANSWERS_PER_HOST=16
OUTBOSS_GTM_HISTORY_PER_PAGE=20
OUTBOSS_GTM_AUTOSAVE_PER_MINUTE_PER_USER=120
OUTBOSS_GTM_AUTOSAVE_PER_MINUTE_PER_WORKSPACE=300
OUTBOSS_GTM_MUTATIONS_PER_MINUTE_PER_USER=60
OUTBOSS_GTM_MUTATIONS_PER_MINUTE_PER_WORKSPACE=180
OUTBOSS_GTM_RESEARCH_PER_MINUTE_PER_USER=6
OUTBOSS_GTM_RESEARCH_PER_MINUTE_PER_WORKSPACE=12
OUTBOSS_GTM_EXPORT_PER_MINUTE_PER_USER=2
OUTBOSS_GTM_EXPORT_PER_MINUTE_PER_WORKSPACE=5

# Cached workspace favicons are fetched in the low-priority queue. The daily
# scheduler retries a newly missing icon daily for this many days, then checks
# it and every cached icon after the weekly refresh age.
WORKSPACE_AVATAR_QUEUE=low
WORKSPACE_AVATAR_MISSING_RETRY_DAYS=7
WORKSPACE_AVATAR_REFRESH_AFTER_DAYS=7
